<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata for Quvrelo. Installed to /app/share/metainfo in the Flatpak. -->
<component type="desktop-application">
  <id>com.quvrelo.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Quvrelo</name>
  <summary>Photo editing, vector design and page layout in one offline app</summary>

  <developer id="com.quvrelo">
    <name>Quvrelo contributors</name>
  </developer>

  <description>
    <p>
      Quvrelo is an offline, all-in-one creative suite built for schools and small teams.
      Its Photo, Vector and Layout studios share one document, so students and staff can
      move between editing a picture, drawing an illustration and laying out a poster
      without switching apps or converting files.
    </p>
    <ul>
      <li>Photo: pixel layers, brushes, selections, masks, crop and live, non-destructive adjustments</li>
      <li>Vector: shapes, pen and pencil, node editing, gradients, boolean operations, SVG import and export</li>
      <li>Layout: multi-page documents, master pages, linked text frames and print-ready PDF export</li>
      <li>Classroom templates such as worksheets, certificates, timetables and name badges</li>
      <li>High-contrast theme, scalable interface and dyslexia-friendly fonts</li>
    </ul>
    <p>
      Quvrelo needs no account and sends no telemetry. Administrators can manage it for every
      user with a machine-wide policy file.
    </p>
  </description>

  <launchable type="desktop-id">com.quvrelo.app.desktop</launchable>

