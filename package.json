{
  "name": "quvrelo",
  "productName": "Quvrelo",
  "version": "0.5.0",
  "description": "Offline all-in-one creative suite for schools: photo editing, vector design and page layout in one app.",
  "main": "dist-electron/main.js",
  "author": {
    "name": "Quvrelo contributors",
    "email": "finnothompson@gmail.com"
  },
  "homepage": "https://github.com/TheWarrior-tech/Quverelo",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheWarrior-tech/Quverelo.git"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run audit:contrast && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "fabric": "^6.9.1",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.2",
    "onnxruntime-web": "^1.30.0",
    "paper": "^0.12.18",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.quvrelo.app",
    "productName": "Quvrelo",
    "copyright": "Copyright © 2026 Quvrelo contributors",
    "artifactName": "Quvrelo-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "docs/policy.example.json",
        "to": "policy.example.json"
      },
      {
        "from": "build/linux/quvrelo.xml",
        "to": "quvrelo-mime.xml"
      }
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "quvrelo",
        "name": "Quvrelo Document",
        "description": "Quvrelo Document",
        "mimeType": "application/vnd.quvrelo+zip",
        "role": "Editor",
        "icon": "icon"
      },
      {
        "ext": "easel",
        "name": "Quvrelo Document (pre-release)",
        "description": "Quvrelo Document (pre-release format)",
        "mimeType": "application/vnd.easel-studio+zip",
        "role": "Editor",
        "icon": "icon"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "TheWarrior-tech",
        "repo": "Quverelo",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Quvrelo-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quvrelo",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Quvrelo-Setup-${version}-${arch}.${ext}"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quvrelo",
      "artifactName": "Quvrelo-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip",
        "pkg"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Quvrelo-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Quvrelo ${version}"
    },
    "pkg": {
      "installLocation": "/Applications",
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": true,
      "isRelocatable": false,
      "isVersionChecked": false,
      "overwriteAction": "upgrade"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Graphics;2DGraphics;VectorGraphics;RasterGraphics;Publishing;",
      "executableName": "quvrelo",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "maintainer": "Quvrelo contributors <finnothompson@gmail.com>",
      "vendor": "Quvrelo",
      "synopsis": "Photo, vector and layout design in one app",
      "description": "Offline all-in-one creative suite: Photo, Vector and Layout studios in one app.",
      "desktop": {
        "entry": {
          "Name": "Quvrelo",
          "GenericName": "Creative Suite",
          "Keywords": "design;photo;vector;layout;illustration;publishing;",
          "StartupWMClass": "Quvrelo"
        }
      },
      "mimeTypes": [
        "application/x-quvrelo",
        "application/x-easel"
      ],
      "artifactName": "Quvrelo-${version}-${arch}.${ext}"
    },
    "deb": {
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "rpm": {
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },
    "appImage": {
      "artifactName": "Quvrelo-${version}-${arch}.${ext}"
    }
  }
}
